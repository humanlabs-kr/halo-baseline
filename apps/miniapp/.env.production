# Build-time values for `vite build --mode production`.
#
# Everything here is compiled into the browser bundle, so none of it can be
# secret — that is exactly why it is safe to commit. Anything that must stay
# private cannot be a VITE_ variable in the first place; it belongs on the API.
#
# Deliberately empty: VITE_*_RPC_URL. Our provider URLs carry an API key in the
# path, and a key in a public repo is a key on a scraper's list within the hour.
# Leave them unset to use the public endpoints, or inject a keyed URL at build
# time from CI. (Note the same key is already visible in the shipped bundle —
# scope it to our origins in the provider dashboard.)

VITE_PROJECT_ENV=production
VITE_API_URL=https://api.halo.humanlabs.world

VITE_WORLD_APP_ID=app_c35ac7dbe6bfaee48efa9496895a49a7
VITE_KAIA_CLIENT_ID=3784c607-6b43-473a-899e-68ed70098e83
VITE_KAIA_LIFF_ID=2008843741-ys04RAGi

VITE_CELO_RPC_URL=
VITE_WORLDCHAIN_RPC_URL=
VITE_KAIA_RPC_URL=

VITE_TURNSTILE_SITE_KEY=0x4AAAAAACxzAP1vU3S8Gs0A
VITE_DEVELOPER_ADDRESSES=
VITE_GEO_API_URL=https://geo.x3x.studio/
VITE_HALO_MINI_LINK=https://link.humanlabs.world/halo-mini/DuzTVQML
VITE_SUPPORT_EMAIL=support@humanlabs.world

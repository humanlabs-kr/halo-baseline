{
  "name": "@halo/miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-locales.mjs && vitest run",
    "check:locales": "node scripts/check-locales.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "cf-codegen": "wrangler types -c wrangler.jsonc",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build --mode staging && wrangler deploy --env staging",
    "deploy:production": "CLOUDFLARE_ENV=production vite build --mode production && wrangler deploy --env production"
  },
  "dependencies": {
    "@halo/contracts": "workspace:*",
    "@line/liff": "^2.31.0",
    "@linenext/dapp-portal-sdk": "^1.6.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@worldcoin/minikit-js": "^1.11.0",
    "canvas-confetti": "^1.9.4",
    "dayjs": "^1.11.23",
    "eruda": "3.4.1",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^15.7.4",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2",
    "viem": "^2.56.8",
    "wagmi": "^3.7.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.7",
    "wrangler": "4.48.0"
  }
}

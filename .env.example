# Every key the system reads. Names only — no values, ever.
#
# First clone? Copy this file, fill in what you need, and drop it where each
# app looks:
#
#   cp .env.example apps/api/.dev.vars        # wrangler dev only reads .dev.vars
#   cp .env.example packages/database/.env
#
# The mini app is different: its config is build-time and public, so the real
# values are committed in apps/miniapp/.env.staging and .env.production.
#
# Where each kind of value lives in a deployed environment:
#
#   secret (JWT_SECRET, API keys, signer key, keyed RPC URLs)
#       → Cloudflare, via `wrangler secret put`. Never in this repo.
#   non-secret Worker config (URLs, CORS, contract addresses, app ids)
#       → apps/api/wrangler.jsonc, under each environment's `vars`.
#   browser config (VITE_*)
#       → apps/miniapp/.env.<env>, committed, because it ships in the bundle.
#
# Adding a key means adding it here and to whichever of those three it belongs
# in. If you are unsure, ask whether reading it helps an attacker: if yes it is
# a secret, and it cannot be a VITE_ variable.

# ── api ──────────────────────────────────────────────────────────────────────
PROJECT_ENV=local

# Signs user sessions (HS256).
JWT_SECRET=
# Signs login nonces. Separate from JWT_SECRET so a leaked nonce key cannot mint
# sessions.
SESSION_HMAC_SECRET=
# Guards every /v1/admin/* route. 32+ random bytes — this is the only thing in
# front of the admin surface.
ADMIN_API_TOKEN=

# Vision model used for receipt analysis.
OPENROUTER_API_KEY=
# Signs point-claim vouchers. Holds no funds and cannot move tokens; it only
# attests that a receipt earned N points.
SERVER_SIGNER_PRIVATE_KEY=
# Signs CCIP-Read responses for *.halo.eth. Holds no funds and settles nothing:
# for a finalised epoch HaloResolver re-reads the oracle and rejects a signed
# value that disagrees, so this key only carries weight for the provisional
# figure. Unset means the gateway answers 400 rather than pretending to sign.
ENS_GATEWAY_SIGNER_KEY=
# Cloudflare Turnstile, secret half of the pair.
TURNSTILE_SECRET_KEY=
# Transactional email (verification codes). Unset disables sending.
MAILEROO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com

# Domain the session cookie is scoped to. Empty for localhost.
API_COOKIE_DOMAIN=
# Extra hostnames a SIWE login message may claim to come from, comma separated.
# The deployed hostnames are built in (apps/api/src/lib/siwe.ts); this is for the
# per-developer Cloudflare tunnel hostname, which lives in the CF dashboard and
# so cannot be listed in code. Empty in staging and production — anything set
# here really does widen which origins can mint a session.
LOCAL_ALLOWED_DOMAINS=
# Comma separated, exact match.
PREDEFINED_CORS_ORIGINS=http://localhost:8000
# Comma separated. Allows any origin ending in these domains.
CORS_ORIGIN_BASE_DOMAINS=
# Public origin of this API, used when it needs to address itself.
API_URL=http://localhost:8001

# World App mini app id — required to verify World ID proofs.
WORLD_APP_ID=

CELO_RPC_URL=https://forno.celo.org
WORLDCHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
KAIA_RPC_URL=https://public-en.node.kaia.io
POINT_CLAIM_CONTRACT_CELO=

# Optional raffle payout provider. Both unset = winners are recorded and paid
# out by hand.
DROP_API_URL=
DROP_ID=

# ── miniapp ──────────────────────────────────────────────────────────────────
# Only VITE_-prefixed values reach the browser bundle. Never put a secret here.
VITE_API_URL=http://localhost:8001
VITE_PROJECT_ENV=local

# Turnstile site key (public half). Receipt upload and email verification are
# blocked without it.
VITE_TURNSTILE_SITE_KEY=

# Required when serving the `world` platform.
VITE_WORLD_APP_ID=
# LINE DappPortal client id + LIFF id — required when serving `kaia`.
VITE_KAIA_CLIENT_ID=
VITE_KAIA_LIFF_ID=

# RPC overrides. Unset falls back to each chain's public endpoint.
VITE_CELO_RPC_URL=https://forno.celo.org
VITE_WORLDCHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
VITE_KAIA_RPC_URL=https://public-en.node.kaia.io

# Comma separated. Wallets that get QA affordances. Empty in a real deployment.
VITE_DEVELOPER_ADDRESSES=
# Cross-promo. Both unset = banner, popup and campaign page stay hidden.
VITE_GEO_API_URL=
VITE_HALO_MINI_LINK=
# Shown to users whose account was suspended.
VITE_SUPPORT_EMAIL=support@example.com

# ── database ─────────────────────────────────────────────────────────────────
DATABASE_MIGRATION_URL=

# ── onchain (contract deployment only) ───────────────────────────────────────
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# ── per developer (.env.local — gitignored) ──────────────────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=   # exposes localhost over https for wallet webviews
